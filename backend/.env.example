# LLM API Keys
GOOGLE_API_KEY=your-google-api-key
OPENAI_API_KEY=your-openai-api-key

# Database (Neon Postgres in prod, SQLite for local dev)
HARNESS_DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Auth
HARNESS_JWT_SECRET=dev-secret-change-me

# OTel (optional, leave empty for local dev)
HARNESS_OTEL_ENDPOINT=

# App
HARNESS_ENVIRONMENT=development
HARNESS_CORS_ORIGINS=["http://localhost:3000"]
